PORT=4000
# Orígenes permitidos (CORS), separados por coma.
WEB_ORIGIN=http://localhost:3000
# Token del panel admin (mín. 8 caracteres; usa uno largo y aleatorio).
ADMIN_TOKEN=cambia-este-token-por-uno-largo
# Carpeta de valores manuales (IVA, UVT, IPC...). En Railway: Volume montado en /data
DATA_DIR=./data
# SMTP. Si SMTP_HOST está vacío, los mensajes solo se registran en logs.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO=integralconsulting.sas@gmail.com
CONTACT_FROM="Sitio web Integral Consulting <no-reply@tudominio.com>"
